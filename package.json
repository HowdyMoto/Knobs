{
  "name": "audio-knobs",
  "version": "1.0.1",
  "description": "Rotatable knob and slider controls for audio/music web apps - like guitar amps and vintage stereos",
  "main": "dist/knobs.js",
  "module": "dist/knobs.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/knobs.esm.js",
      "require": "./dist/knobs.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HowdyMoto/Knobs.git"
  },
  "bugs": {
    "url": "https://github.com/HowdyMoto/Knobs/issues"
  },
  "homepage": "https://github.com/HowdyMoto/Knobs#readme",
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --outfile=dist/knobs.js --format=iife --global-name=Knobs && esbuild src/index.ts --bundle --outfile=dist/knobs.esm.js --format=esm",
    "dev": "tsc --watch",
    "watch": "esbuild src/index.ts --bundle --outfile=dist/knobs.esm.js --format=esm --watch",
    "examples": "http-server . -p 8080 -o examples/index.html",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "knob",
    "dial",
    "slider",
    "fader",
    "audio",
    "music",
    "ui",
    "control",
    "svg",
    "web-audio",
    "synthesizer",
    "mixer"
  ],
  "author": "Wright Bagwell",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.19.0",
    "http-server": "^14.1.1",
    "typescript": "^5.0.0"
  }
}
